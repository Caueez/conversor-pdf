APP_ENV=dev
APP_NAME=account-service
APP_DEBUG=true

APP_PERSISTENCE_BACKEND=postgres
APP_CACHE_BACKEND=redis
APP_BROKER_BACKEND=rabbitmq

APP_POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/user_service
APP_REDIS_DSN=redis://redis:6379/0
APP_RABBITMQ_DSN=amqp://guest:guest@rabbitmq:5672/

APP_USER_REPO=postgres
APP_SESSION_REPO=postgres

APP_PASSWORD_HASHER_ROUNDS=12

APP_JWT_SECRET=change-me-in-production
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=7

APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_NAME=Admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
APP_BOOTSTRAP_ADMIN_PASSWORD=admin123
